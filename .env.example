# Zoostr  -  Environment Variables
# Copy to .env.local for local development
# Set on Vercel dashboard for production

# ── Public (exposed to browser + build) ────────────────────────────────────
# Base URL  -  used for OG image URLs, Farcaster Frame meta and the sitemap.
# Unset falls back to VERCEL_PROJECT_PRODUCTION_URL, then https://zoostr.vercel.app
NEXT_PUBLIC_BASE_URL=https://zoostr.vercel.app

# ── Server-only (NOT exposed to browser) ───────────────────────────────────
# Boostr stats endpoint. Default: https://boostr.sahban.dev/api/zabal/stats
# BOOSTR_STATS_URL=

# ── Ops scripts (pass inline or export before running) ─────────────────────
# Neynar API key  -  used by npm run resolve-wallets (scripts/fid-to-wallet.ts)
# Get a free key at https://neynar.com
# NEYNAR_API_KEY=
