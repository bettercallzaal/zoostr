# Zoostr — Environment Variables
# Copy to .env.local for local development
# Set on Vercel dashboard for production

# ── Public (exposed to browser + build) ────────────────────────────────────
# Base URL — used for OG image URLs and Farcaster Frame meta
NEXT_PUBLIC_BASE_URL=https://zoostr.xyz

# Token contract address — set AFTER deploying on clanker.world
# Shows a "Token Live" green banner with Basescan link when set
# Leave empty before deploy — site shows "Deploying soon" placeholder
NEXT_PUBLIC_TOKEN_ADDRESS=

# 0xSplits contract address — set after deploying the Split at app.splits.org
# Used by: /receipt page (splits.org claim link), /zol admin page
NEXT_PUBLIC_SPLITS_ADDRESS=

# Community pool share — Zoostr starts at 50% (50/25/25 split) from day 1
# Used by: /receipt earnings projections, /zol admin, EarningsCalc component
# Set to 50 for Zoostr. Update if the on-chain split changes.
NEXT_PUBLIC_COMMUNITY_SHARE_PCT=50

# Link to the Sparkz product site (shown on /launch page)
NEXT_PUBLIC_SPARKZ_URL=https://sparkz.xyz

# ── Server-only (NOT exposed to browser) ───────────────────────────────────
# Neynar API key — required for /api/zol/post (ZOL cast posting) + ops scripts
# Get a free key at https://neynar.com
# Used by: /api/zol/post route, npm run resolve-wallets
NEYNAR_API_KEY=

# Neynar signer UUID — required for /api/zol/post to post casts as ZOL
# Create a signer in the Neynar dashboard after getting an API key
NEYNAR_SIGNER_UUID=

# Assumed daily trading volume for /zol admin earnings projections
# Default: 10000 ($10k/day)
ZOL_ASSUMED_VOLUME=10000

# ── Optional backends (features activate when keys are present) ─────────────
# Stripe secret key — activates card backing on /back
# STRIPE_SECRET_KEY=sk_live_...

# Resend API key — activates email confirmations for /back and /tiers
# RESEND_API_KEY=re_...

# Email address for ZAO notifications (backing confirmations, new vetted applications)
# ZAO_NOTIFY_EMAIL=zaalp99@gmail.com

# ── Ops scripts (pass inline or export before running) ─────────────────────
# 0xSplits contract address (same as NEXT_PUBLIC_SPLITS_ADDRESS, for scripts)
# Used by: npm run snapshot  (scripts/snapshot-split.ts)
# SPLITS_ADDRESS=0x...

# Community pool percentage for ops scripts (same as NEXT_PUBLIC_COMMUNITY_SHARE_PCT)
# Zoostr default is 50. Used by: npm run receipt, npm run detect-moment
# COMMUNITY_PCT=50

# Assumed daily trading volume in USD for receipt cast projections
# Used by: npm run receipt  (scripts/receipt-cast.ts)
# Default: 10000 ($10k/day)
# VOLUME=10000
